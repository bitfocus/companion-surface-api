{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "/assets/manifest.schema.json",
	"title": "SurfaceModuleManifest",
	"type": "object",
	"properties": {
		"$schema": { "type": "string" },
		"type": { "type": "string", "enum": ["surface"], "description": "Type of module. Must be: surface" },
		"id": {
			"type": "string",
			"pattern": "^((?!your-module-name)[\\s\\S])*$",
			"description": "Unique identifier for the module"
		},
		"name": { "type": "string", "pattern": "^((?!your-module-name)[\\s\\S])*$", "description": "Name of the module" },
		"shortname": { "type": "string", "pattern": "^((?!module-shortname)[\\s\\S])*$" },
		"description": {
			"type": "string",
			"pattern": "^((?!A short one line description of your module)[\\s\\S])*$",
			"description": "Description of the module"
		},
		"version": { "type": "string", "description": "Current version of the module" },
		"isPrerelease": {
			"description": "Is this a pre-release version. Note: this gets set by the build system",
			"type": "boolean"
		},
		"license": { "type": "string", "description": "SPDX identifier for license of the module" },
		"repository": { "type": "string", "description": "URL to the source repository" },
		"bugs": { "type": "string", "description": "URL to bug tracker" },
		"maintainers": {
			"type": "array",
			"items": { "$ref": "#/$defs/SurfaceModuleManifestMaintainer" },
			"uniqueItems": true,
			"description": "List of active maintainers"
		},
		"runtime": { "$ref": "#/$defs/SurfaceModuleManifestRuntime" },
		"products": {
			"minItems": 1,
			"type": "array",
			"items": { "type": "string", "pattern": "^((?!Your product)[\\s\\S])*$" },
			"uniqueItems": true
		},
		"keywords": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
		"usbIds": {
			"type": "array",
			"items": { "$ref": "#/$defs/SurfaceModuleManifestUsbIds" },
			"uniqueItems": true,
			"description": "List of USB vendor and product IDs that the module supports. Your module will only be notified of devices matching these IDs."
		},
		"allowMultipleInstances": {
			"description": "Whether multiple instances of this module can be run simultaneously",
			"type": "boolean"
		}
	},
	"required": [
		"type",
		"id",
		"name",
		"shortname",
		"description",
		"version",
		"license",
		"repository",
		"bugs",
		"maintainers",
		"runtime",
		"products",
		"keywords",
		"usbIds"
	],
	"$defs": {
		"SurfaceModuleManifestMaintainer": {
			"type": "object",
			"properties": {
				"name": { "type": "string", "pattern": "^((?!Your name)[\\s\\S])*$" },
				"email": { "type": "string", "pattern": "^((?!Your email)[\\s\\S])*$" },
				"github": { "type": "string" },
				"url": { "type": "string" }
			},
			"required": ["name"],
			"title": "SurfaceModuleManifestMaintainer"
		},
		"SurfaceModuleManifestRuntime": {
			"type": "object",
			"properties": {
				"type": {
					"type": "string",
					"enum": ["node22", "node26"],
					"description": "Type of the module. Must be: node22 or node26"
				},
				"apiVersion": { "type": "string", "description": "The version of the host-api used" },
				"entrypoint": { "type": "string", "description": "Entrypoint to pass to the runtime. eg index.js" }
			},
			"required": ["type", "apiVersion", "entrypoint"],
			"description": "Information on how to execute the module",
			"title": "SurfaceModuleManifestRuntime"
		},
		"SurfaceModuleManifestUsbIds": {
			"type": "object",
			"properties": {
				"vendorId": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
				"productIds": {
					"minItems": 1,
					"type": "array",
					"items": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
					"uniqueItems": true
				}
			},
			"required": ["vendorId", "productIds"],
			"title": "SurfaceModuleManifestUsbIds"
		}
	}
}
